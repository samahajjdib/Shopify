<section class="rich-text" style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};">
  <div class="container rich-text__inner">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.text != blank %}<div class="rich-text__body">{{ section.settings.text }}</div>{% endif %}
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="btn btn--secondary">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for teens who need to move their hands" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every squishy is non-toxic, BPA-free, and built to survive backpacks, lockers, and finals week.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#5B2A86" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "Rich text" }
  ]
}
{% endschema %}
