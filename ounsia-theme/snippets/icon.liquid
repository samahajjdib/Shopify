{%- comment -%}
  Accepts: name (string). Line icons matching the Ounsia+ packaging style.
{%- endcomment -%}
{%- case name -%}
  {%- when 'search' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5" stroke-linecap="round"/></svg>
  {%- when 'account' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" stroke-linecap="round"/></svg>
  {%- when 'cart' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3.5" y="6" width="17" height="15" rx="3"/><path d="M8.5 10a3.5 3.5 0 0 0 7 0" stroke-linecap="round"/><path d="M8 6V5a4 4 0 0 1 8 0v1"/></svg>
  {%- when 'globe' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"/></svg>
  {%- when 'chevron-down' -%}
    <svg class="icon icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'arrow-right' -%}
    <svg class="icon icon--sm icon--flip-rtl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'menu' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg>
  {%- when 'close' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke-linecap="round"/></svg>
  {%- when 'check' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m6 12.5 4 4 8-9" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'check-badge' -%}
    <svg class="icon" viewBox="0 0 40 40" aria-hidden="true"><path fill="currentColor" d="M20 1.5l4 3.1 5-.6 1.9 4.7 4.7 1.9-.6 5 3.1 4-3.1 4 .6 5-4.7 1.9-1.9 4.7-5-.6-4 3.1-4-3.1-5 .6-1.9-4.7-4.7-1.9.6-5L1.5 20l3.1-4-.6-5 4.7-1.9L10.6 4.4l5 .6z"/><path d="m13 20.5 4.5 4.5 9.5-10" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'star' -%}
    <svg class="icon icon--star" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="m12 2.8 2.8 5.8 6.4.9-4.6 4.5 1.1 6.3L12 17.3l-5.7 3 1.1-6.3-4.6-4.5 6.4-.9z"/></svg>
  {%- when 'sparkle' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2c.6 5.4 4.6 9.4 10 10-5.4.6-9.4 4.6-10 10-.6-5.4-4.6-9.4-10-10 5.4-.6 9.4-4.6 10-10Z"/></svg>
  {%- when 'lotus' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 20c-3-2-4.5-5-4.5-8.5C7.5 8 9.5 5 12 3.5c2.5 1.5 4.5 4.5 4.5 8S15 18 12 20Z"/><path d="M12 20c-4 0-8-2.5-9-7 2.5-.5 4.5 0 6 1M12 20c4 0 8-2.5 9-7-2.5-.5-4.5 0-6 1"/></svg>
  {%- when 'bolt' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M13.5 2.5 5 13.5h6l-1 8 8.5-11h-6z" stroke-linejoin="round"/></svg>
  {%- when 'face' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M6 12c0-4.4 2.7-8 6-8s6 3.6 6 8-2.7 8-6 8-6-3.6-6-8Z"/><path d="M6.2 10c2.8 0 5.5-1.6 6.8-4 .9 2 2.7 3.5 4.8 4"/><path d="M10 15.5c1.2.8 2.8.8 4 0" stroke-linecap="round"/><path d="m19.5 4 .4 1.1 1.1.4-1.1.4-.4 1.1-.4-1.1-1.1-.4 1.1-.4z"/></svg>
  {%- when 'gut' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M9 3v3c0 1.5-3 1.5-3 4s3 2.5 6 2.5 5.5 0 5.5 2.5-2.5 2.5-5.5 2.5-4 .5-4 2V21"/><path d="M15 3v2.5c0 1.5 3 1.5 3 3.5"/></svg>
  {%- when 'leaf' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 19C5 10 10 5 20 4c0 9-5 15-13 15"/><path d="M5 19c3-4 6-7 10-9.5" stroke-linecap="round"/></svg>
  {%- when 'no-color' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 6.5c2 2.5 3.5 4.5 3.5 6.5a3.5 3.5 0 0 1-7 0c0-2 1.5-4 3.5-6.5Z"/><path d="m5.6 5.6 12.8 12.8"/></svg>
  {%- when 'wheat' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 22V6"/><path d="M12 6c-1.5-1-1.5-3 0-4 1.5 1 1.5 3 0 4ZM12 11c-2 0-3.5-1.5-3.5-3.5 2 0 3.5 1.5 3.5 3.5Zm0 0c2 0 3.5-1.5 3.5-3.5-2 0-3.5 1.5-3.5 3.5ZM12 15.5c-2 0-3.5-1.5-3.5-3.5 2 0 3.5 1.5 3.5 3.5Zm0 0c2 0 3.5-1.5 3.5-3.5-2 0-3.5 1.5-3.5 3.5Z"/></svg>
  {%- when 'flask' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M9 3h6M10 3v6L4.5 18.5A1.7 1.7 0 0 0 6 21h12a1.7 1.7 0 0 0 1.5-2.5L14 9V3"/><path d="M7 15h10"/></svg>
  {%- when 'heart' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 20s-7.5-4.5-7.5-10A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 7.5 3c0 5.5-7.5 10-7.5 10Z"/></svg>
  {%- when 'glass' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 4h14l-1.6 15.2A2 2 0 0 1 15.4 21H8.6a2 2 0 0 1-2-1.8Z"/><path d="M5.7 10h12.6"/></svg>
  {%- when 'instagram' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
  {%- when 'tiktok' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 2.5 2.5 4.5 5 4.5"/></svg>
  {%- when 'facebook' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14.5 21v-8h3l.5-3.5h-3.5V7.5c0-1 .4-1.8 1.8-1.8H18V2.6c-.4 0-1.5-.1-2.7-.1-2.7 0-4.3 1.6-4.3 4.5v2.5H8V13h3v8"/></svg>
  {%- when 'halal' -%}
    <svg class="icon icon--halal" viewBox="0 0 24 24" aria-hidden="true"><text x="12" y="15.5" text-anchor="middle" font-size="11" font-weight="700" font-family="'Noto Naskh Arabic', 'Geeza Pro', 'Arial', sans-serif" fill="currentColor">حلال</text></svg>
  {%- when 'certificate' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="m9.5 9 1.8 1.8 3.4-3.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M8.5 14 7 21l5-2.5 5 2.5-1.5-7"/></svg>
{%- endcase -%}
