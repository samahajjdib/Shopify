<!doctype html>
<html lang="{{ request.locale.iso_code }}"{% if request.locale.iso_code == 'ar' %} dir="rtl"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  <style>
    {{ settings.font_heading | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_face: font_display: 'swap' }}
  </style>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Naskh+Arabic:wght@500&display=swap" rel="stylesheet">
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {% render 'css-variables' %}
</head>
<body class="password-page">
  <div class="password-page__wrap">
    {% render 'logo' %}
    <p class="password-page__tagline">{{ shop.password_message | default: 'Good mood. Daily. Coming soon.' }}</p>

    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <div class="inline-form">
        <input type="password" name="password" placeholder="{{ 'general.password_page.password' | t }}" required>
        <button type="submit" class="btn btn--primary">{{ 'general.password_page.login_password_button' | t }}</button>
      </div>
    {% endform %}

    {{ content_for_layout }}
  </div>
</body>
</html>
