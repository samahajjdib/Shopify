<style>
  /* Badge text scales with the badge and stays inside the star's inner circle */
  .starburst { width: 150px; height: 150px; container-type: inline-size; }
  .starburst span {
    display: block; max-width: 70%;
    font-size: 15px; font-size: 10cqw;
    line-height: 1.1; letter-spacing: 0; overflow-wrap: anywhere;
  }
  @media (max-width: 860px) {
    .starburst { width: 116px; height: 116px; }
  }
  /* Image-only slides: the photo already carries the logo and text, so show it whole */
  .hero__slides { grid-template-columns: minmax(0, 1fr); }
  .hero__slide { min-width: 0; }
  .hero__slide--image-only { min-height: 0; aspect-ratio: var(--slide-ratio); align-items: flex-end; align-self: start; }
  .hero__slide--image-only .hero__content { justify-content: flex-start; padding-bottom: 48px; }
  .hero__slide--image-only .hero__content::before { display: none; }
  .hero__image--mobile { display: none; }
  @media (max-width: 860px) {
    /* Phones: photo on top at full width, button underneath instead of covering the photo */
    .hero__slide--image-only { display: block; aspect-ratio: auto; background: var(--color-background); }
    .hero__slide--image-only .hero__image {
      position: static; display: block; width: 100%; height: auto;
      aspect-ratio: var(--slide-ratio-mobile, var(--slide-ratio)); object-fit: cover;
    }
    .hero__slide--image-only .hero__image--mobile { display: block; }
    .hero__slide--image-only.has-mobile-image .hero__image--desktop { display: none; }
    .hero__slide--image-only .hero__overlay { display: none; }
    .hero__slide--image-only .hero__content { padding: 14px 16px 16px; align-items: flex-start; }
    .hero__slide--image-only .btn--lg { padding: 12px 28px; font-size: 13px; }
    .hero:has(.hero__slide--image-only) .hero__dots { bottom: 36px; left: auto; right: 16px; transform: none; }
  }
</style>
<section class="hero" data-slideshow data-autoplay="{{ section.settings.autoplay_seconds }}" style="--hero-height: {{ section.settings.height }}px;">
  <div class="hero__slides">
    {%- for block in section.blocks -%}
      {%- liquid
        assign image_only = false
        if block.settings.image != blank and block.settings.heading == blank and block.settings.text == blank
          assign image_only = true
        endif
      -%}
      <div class="hero__slide{% if forloop.first %} is-active{% endif %}{% if image_only %} hero__slide--image-only{% endif %}{% if block.settings.mobile_image != blank %} has-mobile-image{% endif %}" data-slide {{ block.shopify_attributes }} style="--slide-bg: {{ block.settings.background }};{% if image_only %} --slide-ratio: {{ block.settings.image.aspect_ratio }};{% endif %}{% if block.settings.mobile_image != blank %} --slide-ratio-mobile: {{ block.settings.mobile_image.aspect_ratio }};{% endif %}">
        {%- if block.settings.image -%}
          {%- if forloop.first -%}{%- assign img_loading = 'eager' -%}{%- else -%}{%- assign img_loading = 'lazy' -%}{%- endif -%}
          {{ block.settings.image | image_url: width: 2400 | image_tag: class: 'hero__image hero__image--desktop', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2400', loading: img_loading }}
          {%- if block.settings.mobile_image != blank -%}
            {{ block.settings.mobile_image | image_url: width: 1200 | image_tag: class: 'hero__image hero__image--mobile', sizes: '100vw', widths: '600, 900, 1200', loading: img_loading }}
          {%- endif -%}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__image hero__image--placeholder' }}
        {%- endif -%}
        <div class="hero__overlay" style="opacity: {{ block.settings.overlay | divided_by: 100.0 }};"></div>

        <div class="hero__content container hero__content--{{ block.settings.text_color }}">
          <div class="hero__text">
            {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            {%- if block.settings.heading != blank -%}<h2 class="hero__heading">{{ block.settings.heading }}</h2>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="hero__subheading">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg">{{ block.settings.button_label }}</a>
            {%- endif -%}
          </div>
          {%- if block.settings.badge_text != blank -%}
            <div class="starburst" style="--badge-bg: {{ block.settings.badge_color }};">
              <span>{{ block.settings.badge_text | newline_to_br }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero__dots" role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" class="hero__dot{% if forloop.first %} is-active{% endif %}" data-slide-dot="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero slideshow",
  "tag": "div",
  "settings": [
    { "type": "range", "id": "height", "label": "Desktop height", "min": 400, "max": 900, "step": 20, "unit": "px", "default": 720 },
    { "type": "range", "id": "autoplay_seconds", "label": "Change slides every (0 = off)", "min": 0, "max": 12, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Wide photo, 2400px wide recommended. Leave Heading and Text empty to show the photo whole (for photos that already include your logo and text)." },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)", "info": "A taller photo for phones, e.g. 1080 x 1350px. If empty, the main image is shown full width on phones." },
        { "type": "color", "id": "background", "label": "Background (behind image)", "default": "#F7E3DE" },
        { "type": "range", "id": "overlay", "label": "Dark overlay", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 0 },
        { "type": "select", "id": "text_color", "label": "Text color", "default": "dark", "options": [ { "value": "dark", "label": "Plum" }, { "value": "light", "label": "White" } ] },
        { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Good mood. Daily." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Small habits. Big changes." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Our Myo-Inositol & D-Chiro Inositol powder in a 4:1 ratio helps support hormonal balance, energy, clear skin and mood. Just mix & go.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "textarea", "id": "badge_text", "label": "Starburst badge text", "default": "NEW\nFLAVOURS" },
        { "type": "color", "id": "badge_color", "label": "Badge color", "default": "#FAE6DA" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Hero slideshow",
      "blocks": [ { "type": "slide" } ]
    }
  ]
}
{% endschema %}
