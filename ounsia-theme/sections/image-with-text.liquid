<section class="section split" style="background: {{ section.settings.background }};">
  <div class="container split__inner{% if section.settings.image_position == 'right' %} split__inner--reverse{% endif %}">
    <div class="split__media">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'split__image', loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400' }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'split__image split__image--placeholder' }}
      {%- endif -%}
    </div>
    <div class="split__content">
      {%- if section.settings.script_text != blank -%}<p class="script">{{ section.settings.script_text }}</p>{%- endif -%}
      <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.blocks.size > 0 -%}
        <ol class="steps">
          {%- for block in section.blocks -%}
            <li class="step" {{ block.shopify_attributes }}>
              <span class="step__num">{{ forloop.index }}</span>
              <div>
                <h3 class="step__title">{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "right", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "text", "id": "script_text", "label": "Handwritten text", "default": "Mix & Go" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your 30-second good mood ritual" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Delicious. Convenient. Effective.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Find your flavour" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFDFC" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Tear" },
        { "type": "text", "id": "text", "label": "Text", "default": "Open one sachet." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        { "type": "step", "settings": { "title": "Tear", "text": "Open one 7g sachet." } },
        { "type": "step", "settings": { "title": "Pour", "text": "Add it to a glass of cold water." } },
        { "type": "step", "settings": { "title": "Sip", "text": "Stir, enjoy, and repeat daily." } }
      ]
    }
  ]
}
{% endschema %}
