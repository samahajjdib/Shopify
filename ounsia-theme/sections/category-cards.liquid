<section class="section cards-section" style="background: {{ section.settings.background }};">
  <div class="container">
    <div class="section-heading">
      <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="section-heading__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="cards cards--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="card" {{ block.shopify_attributes }}>
          <div class="card__media" style="background: {{ block.settings.tint }};">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: class: 'card__image', loading: 'lazy', sizes: '(min-width: 990px) 25vw, 80vw', widths: '400, 600, 800' }}
            {%- else -%}
              {{ 'product-2' | placeholder_svg_tag: 'card__image card__image--placeholder' }}
            {%- endif -%}
            <span class="card__arrow">{% render 'icon', name: 'arrow-right' %}</span>
          </div>
          <h3 class="card__title">{{ block.settings.title }}</h3>
          <p class="card__text">{{ block.settings.text }}</p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category cards",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real self-care starts inside" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Made for women, by women who know how much your hormones shape your day. Find your Ounsia+ ritual.</p>" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FCF7F4" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "color", "id": "tint", "label": "Background tint", "default": "#F7E3DE" },
        { "type": "text", "id": "title", "label": "Title", "default": "Daily Powder" },
        { "type": "text", "id": "text", "label": "Text", "default": "Your daily Inositol ritual." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Category cards",
      "blocks": [
        { "type": "card", "settings": { "title": "Daily Pouches", "text": "30 sachets of your favourite flavour for a whole month.", "tint": "#F7E3DE" } },
        { "type": "card", "settings": { "title": "Flavour Bundles", "text": "Strawberry, passion fruit & lime. Different flavours, same happy you.", "tint": "#F1E6EC" } },
        { "type": "card", "settings": { "title": "Mix & Go Sachets", "text": "Single-serve sticks for your bag, desk or gym.", "tint": "#FAE6DA" } },
        { "type": "card", "settings": { "title": "Gift Sets", "text": "Share the good mood with someone you love.", "tint": "#E7ECDA" } }
      ]
    }
  ]
}
{% endschema %}
