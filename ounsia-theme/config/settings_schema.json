  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "Leave empty to show the store name as a text logo."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 60,
        "max": 260,
        "step": 5,
        "unit": "px",
        "default": 130
      },
      {
        "type": "text",
        "id": "logo_subtitle",
        "label": "Text logo subtitle",
        "default": "أنسية"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image"
      }
    ]
  },
