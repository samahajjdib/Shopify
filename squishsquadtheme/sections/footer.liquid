<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__newsletter">
      <h2>{{ 'sections.footer.newsletter_heading' | t }}</h2>
      <p>{{ 'sections.footer.newsletter_text' | t }}</p>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-form">
          <input type="email" name="contact[email]" placeholder="{{ 'sections.footer.newsletter_placeholder' | t }}" required>
          <button type="submit" class="btn btn--primary">{{ 'sections.footer.newsletter_button' | t }}</button>
        </div>
        {% if form.posted_successfully? %}
          <p class="form-success">You're in! Watch your inbox.</p>
        {% endif %}
      {% endform %}
    </div>

    <div class="site-footer__links">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'menu' %}
            <div class="footer-menu">
              <h3>{{ block.settings.heading }}</h3>
              <ul>
                {% for link in block.settings.menu.links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            </div>
        {% endcase %}
      {% endfor %}

      <div class="site-footer__social">
        {% if settings.social_instagram != blank %}<a href="{{ settings.social_instagram }}">Instagram</a>{% endif %}
        {% if settings.social_tiktok != blank %}<a href="{{ settings.social_tiktok }}">TikTok</a>{% endif %}
        {% if settings.social_youtube != blank %}<a href="{{ settings.social_youtube }}">YouTube</a>{% endif %}
      </div>
    </div>
  </div>
  <div class="site-footer__bottom container">
    <small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</small>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Help" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Help" } }
    ]
  }
}
{% endschema %}
