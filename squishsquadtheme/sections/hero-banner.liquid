<section class="hero" style="background-color: {{ section.settings.background_color }};">
  <div class="container hero__inner">
    <div class="hero__content">
      <h1>{{ section.settings.heading | default: 'sections.hero.default_heading' | t }}</h1>
      <p>{{ section.settings.subheading | default: 'sections.hero.default_subheading' | t }}</p>
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link | default: '#featured' }}" class="btn btn--primary btn--lg">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
    {% if section.settings.image %}
      <div class="hero__media">
        <img
          src="{{ section.settings.image | image_url: width: 900 }}"
          alt="{{ section.settings.heading | escape }}"
          width="900"
          height="{{ 900 | divided_by: section.settings.image.aspect_ratio | default: 900 }}"
        >
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Squeeze the stress away" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Squishable, stretchable, never-the-same-shape-twice toys made for fidgety hands." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FFE8F1" }
  ],
  "presets": [
    { "name": "Hero banner" }
  ]
}
{% endschema %}
