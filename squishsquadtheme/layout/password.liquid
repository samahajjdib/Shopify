<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root{
      --color-background: {{ settings.color_background }};
      --color-text: {{ settings.color_text }};
      --color-primary: {{ settings.color_primary }};
      --color-primary-text: {{ settings.color_primary_text }};
      --color-accent: {{ settings.color_accent }};
      --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
      --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
      --radius: {{ settings.corner_radius }}px;
    }
  </style>
</head>
<body class="password-page">
  <div class="password-page__wrap">
    <h1 class="password-page__logo">{{ shop.name }}</h1>
    <p>{{ shop.password_message | default: "We're mixing up something squishy. Back soon." }}</p>

    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <div class="password-page__form">
        <input type="password" name="password" placeholder="Password" required>
        <button type="submit" class="btn btn--primary">{{ 'general.password_page.login_password_button' | t }}</button>
      </div>
    {% endform %}

    {{ content_for_layout }}
  </div>
</body>
</html>
