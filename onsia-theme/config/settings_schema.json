[
  {
    "name": "theme_info",
    "theme_name": "Onsia+",
    "theme_version": "1.0.0",
    "theme_author": "Onsia+",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "Leave empty to show the store name as a text logo."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 60,
        "max": 260,
        "step": 5,
        "unit": "px",
        "default": 130
      },
      {
        "type": "text",
        "id": "logo_subtitle",
        "label": "Text logo subtitle",
        "default": "أنسية"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FFFBF8"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#4A2230"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary (buttons, logo, headings)",
        "default": "#6E2F3F"
      },
      {
        "type": "color",
        "id": "color_primary_text",
        "label": "Primary button text",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_blush",
        "label": "Blush (Strawberry)",
        "default": "#F6E1E4"
      },
      {
        "type": "color",
        "id": "color_lavender",
        "label": "Lavender",
        "default": "#E6DFF5"
      },
      {
        "type": "color",
        "id": "color_butter",
        "label": "Butter (Passion Fruit)",
        "default": "#F8EDC9"
      },
      {
        "type": "color",
        "id": "color_mint",
        "label": "Mint (Lime)",
        "default": "#DDEEDC"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "playfair_display_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "work_sans_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Max page width",
        "min": 1000,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "default": 1400
      },
      {
        "type": "range",
        "id": "corner_radius",
        "label": "Corner roundness",
        "min": 0,
        "max": 30,
        "step": 2,
        "unit": "px",
        "default": 14
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      }
    ]
  }
]
