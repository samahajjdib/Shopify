<section class="hero" data-slideshow data-autoplay="{{ section.settings.autoplay_seconds }}" style="--hero-height: {{ section.settings.height }}px;">
  <div class="hero__slides">
    {%- for block in section.blocks -%}
      <div class="hero__slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }} style="--slide-bg: {{ block.settings.background }};">
        {%- if block.settings.image -%}
          {%- if forloop.first -%}{%- assign img_loading = 'eager' -%}{%- else -%}{%- assign img_loading = 'lazy' -%}{%- endif -%}
          {{ block.settings.image | image_url: width: 2400 | image_tag: class: 'hero__image', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2400', loading: img_loading }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__image hero__image--placeholder' }}
        {%- endif -%}
        <div class="hero__overlay" style="opacity: {{ block.settings.overlay | divided_by: 100.0 }};"></div>

        <div class="hero__content container hero__content--{{ block.settings.text_color }}">
          <div class="hero__text">
            {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            <h2 class="hero__heading">{{ block.settings.heading }}</h2>
            {%- if block.settings.text != blank -%}<div class="hero__subheading">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg">{{ block.settings.button_label }}</a>
            {%- endif -%}
          </div>
          {%- if block.settings.badge_text != blank -%}
            <div class="starburst" style="--badge-bg: {{ block.settings.badge_color }};">
              <span>{{ block.settings.badge_text | newline_to_br }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero__dots" role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" class="hero__dot{% if forloop.first %} is-active{% endif %}" data-slide-dot="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero slideshow",
  "tag": "div",
  "settings": [
    { "type": "range", "id": "height", "label": "Desktop height", "min": 400, "max": 900, "step": 20, "unit": "px", "default": 720 },
    { "type": "range", "id": "autoplay_seconds", "label": "Change slides every (0 = off)", "min": 0, "max": 12, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Wide lifestyle photo, 2400 x 1200px recommended." },
        { "type": "color", "id": "background", "label": "Background (behind image)", "default": "#F6E1E4" },
        { "type": "range", "id": "overlay", "label": "Dark overlay", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 0 },
        { "type": "select", "id": "text_color", "label": "Text color", "default": "dark", "options": [ { "value": "dark", "label": "Plum" }, { "value": "light", "label": "White" } ] },
        { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Good mood. Daily." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Small habits. Big changes." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Our Myo-Inositol & D-Chiro Inositol powder in a 4:1 ratio helps support hormonal balance, energy, clear skin and mood. Just mix & go.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "textarea", "id": "badge_text", "label": "Starburst badge text", "default": "NEW\nFLAVOURS" },
        { "type": "color", "id": "badge_color", "label": "Badge color", "default": "#F8EDC9" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Hero slideshow",
      "blocks": [ { "type": "slide" } ]
    }
  ]
}
{% endschema %}
